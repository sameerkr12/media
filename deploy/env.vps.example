# Copy to .env.vps at the repository root. Never commit actual values.
SITE_DOMAIN=media.example.com
ACME_EMAIL=you@example.com
APP_URL=https://media.example.com
AUTH_MODE=supabase
ADMIN_EMAIL=you@example.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-server-service-role-key
# Alternative names: SUPABASE_PUBLISHABLE_KEY and SUPABASE_SECRET_KEY.
